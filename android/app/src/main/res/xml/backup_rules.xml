<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup up to Android 11: the map tile cache (UtilTileCache) can be
     hundreds of MB and is re-downloadable; it would exceed the backup quota. -->
<full-backup-content>
    <exclude domain="file" path="map_tiles/" />
    <!-- password (flutter_secure_storage): its key stays in the Keystore of
         the old device, a restored copy can't be decrypted ("Failed to unwrap
         key"). Without it the app asks to sign in again. -->
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration:FlutterSecureStorage.xml" />
</full-backup-content>
